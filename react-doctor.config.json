{
  "$schema": "https://react.doctor/schema/config.json",
  "rules": {
    "react-doctor/only-export-components": "off",
    "react-doctor/no-multi-comp": "off",
    "react-doctor/require-reduced-motion": "off"
  },
  "ignore": {
    "overrides": [
      {
        "files": ["**/empty-state/assets/**", "**/icons/registry.ts"],
        "rules": ["react-doctor/no-barrel-import"]
      },
      {
        "files": ["**/empty-state/assets/**"],
        "rules": ["react-doctor/no-giant-component"]
      },
      {
        "files": ["**/charts/**"],
        "rules": ["react-doctor/prefer-dynamic-import"]
      },
      {
        "files": ["**/animated-counter/animated-counter.tsx"],
        "rules": [
          "react-doctor/no-adjust-state-on-prop-change",
          "react-doctor/no-cascading-set-state",
          "react-doctor/no-derived-useState",
          "react-doctor/prefer-useReducer"
        ]
      },
      {
        "files": ["**/emoji-icon-picker/icon/icon-root.tsx"],
        "rules": [
          "react-doctor/no-adjust-state-on-prop-change",
          "react-doctor/no-derived-state",
          "react-doctor/prefer-useReducer"
        ]
      },
      {
        "files": ["**/collapsible/collapsible.tsx"],
        "rules": ["react-doctor/no-derived-state", "react-doctor/no-event-handler"]
      },
      {
        "files": ["**/tab-navigation/tab-navigation-item.tsx"],
        "rules": ["react-doctor/use-lazy-motion"]
      },
      {
        "files": ["**/portal/modal-portal.tsx"],
        "rules": [
          "react-doctor/advanced-event-handler-refs",
          "react-doctor/prefer-html-dialog",
          "react-doctor/prefer-tag-over-role",
          "react-doctor/dialog-has-accessible-name"
        ]
      },
      {
        "files": ["**/charts/components/legend.tsx"],
        "rules": ["react-doctor/no-static-element-interactions"]
      },
      {
        "// reason": "The rule flags allow-scripts with allow-same-origin because a same-origin frame can then remove its own sandbox. This frame is on a different origin, so the pair only grants draw.io its own origin, never ours. The sandbox still withholds allow-top-navigation, which is the part worth keeping.",
        "files": ["**/pages/editor/diagram-editor.tsx"],
        "rules": ["react-doctor/iframe-missing-sandbox"]
      },
      {
        "// reason": "Upstream-owned files that the upstream sync moved or changed. Left as-is so the next sync does not conflict.",
        "files": [
          "**/components/core/image-picker-popover.tsx",
          "**/components/core/modals/existing-issues-list-modal.tsx",
          "**/src/select/root.tsx"
        ],
        "rules": ["react-doctor/no-giant-component"]
      },
      {
        "files": ["**/components/core/image-picker-popover.tsx"],
        "rules": ["react-doctor/rerender-state-only-in-handlers"]
      },
      {
        "files": ["**/src/select/root.tsx"],
        "rules": ["react-doctor/no-adjust-state-on-prop-change"]
      },
      {
        "files": ["**/src/select/use-infinite-options.ts"],
        "rules": ["react-doctor/no-loading-flag-reset-outside-finally"]
      },
      {
        "files": ["**/src/select/virtual-list-body.tsx"],
        "rules": ["react-doctor/anchor-has-content"]
      },
      {
        "files": ["**/src/emoji-reaction/emoji-reaction.tsx"],
        "rules": ["react-doctor/no-array-index-as-key", "react-doctor/rerender-memo-with-default-value"]
      },
      {
        "files": ["**/src/portal/portal-wrapper.tsx"],
        "rules": ["react-doctor/rerender-memo-before-early-return"]
      },
      {
        "files": ["**/src/charts/components/tooltip.tsx"],
        "rules": ["react-doctor/js-set-map-lookups"]
      },
      {
        "files": ["**/issues/peek-overview/layout.tsx"],
        "rules": ["react-doctor/prefer-html-dialog"]
      },
      {
        "files": ["**/global/product-updates/changelog.tsx"],
        "rules": ["react-doctor/iframe-missing-sandbox"]
      },
      {
        "files": ["**/issue-detail/links/link-detail.tsx"],
        "rules": ["react-doctor/click-events-have-key-events", "react-doctor/no-static-element-interactions"]
      },
      {
        "// reason": "False positive: the label prop is rendered as the button text.",
        "files": ["**/settings/profile/sidebar/item-categories.tsx"],
        "rules": ["react-doctor/control-has-associated-label"]
      },
      {
        "files": [
          "**/components/instance/setup-form.tsx",
          "**/components/account/auth-forms/password.tsx",
          "**/components/issues/issue-layouts/kanban/headers/group-by-card.tsx",
          "**/components/issues/issue-layouts/kanban/kanban-group.tsx",
          "**/components/issues/issue-layouts/list/block.tsx",
          "**/components/issues/issue-layouts/list/list-group.tsx",
          "**/components/issues/issue-layouts/properties/all-properties.tsx",
          "**/components/issues/peek-overview/issue-properties.tsx",
          "**/components/issues/peek-overview/layout.tsx",
          "**/app/*/*/*/projects/*/*/modules/*/header.tsx",
          "**/app/*/workspace-invitations/page.tsx",
          "**/components/comments/card/display.tsx",
          "**/components/core/image-picker-popover.tsx",
          "**/components/cycles/active-cycle/cycle-stats.tsx",
          "**/components/cycles/active-cycle/progress.tsx",
          "**/components/cycles/analytics-sidebar/issue-progress.tsx",
          "**/components/cycles/analytics-sidebar/sidebar-details.tsx",
          "**/components/cycles/list/cycle-list-item-action.tsx",
          "**/components/exporter/single-export.tsx",
          "**/components/inbox/content/inbox-issue-header.tsx",
          "**/components/inbox/content/inbox-issue-mobile-header.tsx",
          "**/components/inbox/content/issue-properties.tsx",
          "**/components/inbox/modals/create-modal/issue-properties.tsx",
          "**/components/integration/single-integration-card.tsx",
          "**/components/issues/issue-detail-widgets/sub-issues/filters.tsx",
          "**/components/issues/issue-detail-widgets/sub-issues/issues-list/list-item.tsx",
          "**/components/issues/issue-detail/main-content.tsx",
          "**/components/issues/issue-detail/sidebar.tsx",
          "**/components/issues/issue-modal/form.tsx",
          "**/components/issues/peek-overview/issue-detail.tsx",
          "**/components/issues/peek-overview/properties.tsx",
          "**/components/issues/workspace-draft/draft-issue-properties.tsx",
          "**/components/modules/analytics-sidebar/issue-progress.tsx",
          "**/components/modules/module-card-item.tsx",
          "**/components/modules/modules-list-view.tsx",
          "**/components/onboarding/profile-setup.tsx",
          "**/components/onboarding/steps/profile/root.tsx",
          "**/components/power-k/ui/pages/context-based/work-item/commands.ts",
          "**/components/project/card.tsx",
          "**/components/settings/profile/content/pages/general/form.tsx",
          "**/components/settings/profile/content/pages/security.tsx",
          "**/components/sidebar/resizable-sidebar.tsx",
          "**/components/stickies/action-bar.tsx",
          "**/components/workspace-notifications/sidebar/notification-card/item.tsx",
          "**/components/workspace/sidebar/projects-list-item.tsx",
          "**/layouts/auth-layout/workspace-wrapper.tsx",
          "**/src/breadcrumb/breadcrumb-navigation-select.tsx",
          "**/src/charts/tree-map/map-content.tsx",
          "**/src/property-select/date-range-select.tsx",
          "**/src/property-select/member-select.tsx",
          "**/src/select/root.tsx",
          "**/src/select/trigger.tsx",
          "**/src/extensions/custom-image/components/uploader.tsx"
        ],
        "rules": ["react-doctor/no-high-complexity-react-function"]
      },
      {
        "files": [
          "**/*/ai/page.tsx",
          "**/onboarding/invite-members.tsx",
          "**/issue-activity/activity/actions/start_date.tsx",
          "**/project/delete-project-modal.tsx"
        ],
        "rules": ["react-doctor/duplicate-jsx-subtree"]
      }
    ]
  }
}
